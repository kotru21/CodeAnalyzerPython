name: CI

on:
  push:
    branches: [main, master]
  pull_request:

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  quality:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-python@v7
        with:
          python-version: "3.14"
          cache: pip
      - run: pip install -e ".[dev]"
      - name: Ruff check
        run: ruff check src tests eval
      - name: Ruff format
        run: ruff format --check src tests eval
      - name: Mypy
        run: mypy src/analyzer

  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-python@v7
        with:
          python-version: "3.14"
          cache: pip
      - run: pip install -e ".[dev]"
      - name: pip-audit
        run: pip-audit
      - name: Pytest
        run: pytest tests/ -q --cov=src/analyzer --cov-report=term-missing

  eval:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-python@v7
        with:
          python-version: "3.14"
          cache: pip
      - run: pip install -e ".[dev]"
      - name: In-process catalog eval
        run: |
          python - <<'PY'
          import json
          from eval.catalog_loader import load_catalog
          from eval.catalog_runner import run_catalog_inprocess
          from eval.metrics import global_counts, precision_recall_f1
          rows = run_catalog_inprocess(load_catalog())
          counts = global_counts(rows)
          p, r, f1 = precision_recall_f1(counts["TP"], counts["FP"], counts["FN"])
          print(json.dumps({"counts": counts, "precision": p, "recall": r, "f1": f1}))
          assert counts["FN"] == 0, f"FN regression: {counts['FN']}"
          assert counts["FP"] <= 10, f"FP budget exceeded: {counts['FP']}"
          PY

  docker:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:17-alpine
        env:
          POSTGRES_USER: analyzer
          POSTGRES_PASSWORD: ci-postgres
          POSTGRES_DB: analyzer
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U analyzer"
          --health-interval 5s
          --health-timeout 3s
          --health-retries 10
      redis:
        image: redis:8-alpine
        ports:
          - 6379:6379
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 5s
          --health-timeout 3s
          --health-retries 10
    steps:
      - uses: actions/checkout@v7
      - uses: docker/setup-buildx-action@v3
      - name: Docker smoke
        env:
          IMAGE: analyzer-ci:local
          POSTGRES_PASSWORD: ci-postgres
          REDIS_PASSWORD: ""
          ANALYZER_API_KEY: ci-smoke-key
        run: bash scripts/ci_docker_smoke.sh


### .pre-commit-config.yaml

# Mirrors CI jobs quality + test. Catalog eval and Docker smoke stay CI-only.
repos:
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.16.2
    hooks:
      - id: ruff
        files: ^(src|tests|eval)/
      - id: ruff-format
        files: ^(src|tests|eval)/

  - repo: local
    hooks:
      - id: mypy
        name: mypy
        entry: python -m mypy src/analyzer
        language: system
        pass_filenames: false
        types: [python]
      - id: pip-audit
        name: pip-audit
        entry: python -m pip_audit
        language: system
        pass_filenames: false
      - id: pytest-cov
        name: pytest with coverage ratchet
        entry: python -m pytest tests/ -q --cov=src/analyzer --cov-report=term-missing
        language: system
        pass_filenames: false
        stages: [pre-commit]


### scripts/ci_docker_smoke.sh

#!/usr/bin/env bash
# CI Docker smoke: build в†’ alembic upgrade в†’ API /api/v1/health.
# Expects Postgres and Redis on 127.0.0.1 (GitHub Actions service containers).
set -euo pipefail

IMAGE="${IMAGE:-analyzer-ci:local}"
POSTGRES_USER="${POSTGRES_USER:-analyzer}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-ci-postgres}"
POSTGRES_DB="${POSTGRES_DB:-analyzer}"
REDIS_PASSWORD="${REDIS_PASSWORD-}"
API_KEY="${ANALYZER_API_KEY:-ci-smoke-key}"

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}"
if [[ -n "${REDIS_PASSWORD}" ]]; then
  REDIS_URL="redis://:${REDIS_PASSWORD}@127.0.0.1:6379/0"
  BROKER_URL="redis://:${REDIS_PASSWORD}@127.0.0.1:6379/1"
  RESULT_URL="redis://:${REDIS_PASSWORD}@127.0.0.1:6379/2"
else
  REDIS_URL="redis://127.0.0.1:6379/0"
  BROKER_URL="redis://127.0.0.1:6379/1"
  RESULT_URL="redis://127.0.0.1:6379/2"
fi

echo "==> Building ${IMAGE}"
docker build -t "${IMAGE}" .

COMMON_ENV=(
  -e "ANALYZER_DATABASE_URL=${DATABASE_URL}"
  -e "ANALYZER_REDIS_URL=${REDIS_URL}"
  -e "ANALYZER_CELERY_BROKER_URL=${BROKER_URL}"
  -e "ANALYZER_CELERY_RESULT_BACKEND=${RESULT_URL}"
  -e "ANALYZER_API_KEY=${API_KEY}"
  -e "ANALYZER_DEBUG=false"
  -e "ANALYZER_RATE_LIMIT_PER_MINUTE=0"
  -e "ANALYZER_RATE_LIMIT_SYNC_PER_MINUTE=0"
)

echo "==> alembic upgrade head"
docker run --rm --network host "${COMMON_ENV[@]}" "${IMAGE}" alembic upgrade head

echo "==> starting API"
cid="$(docker run -d --network host "${COMMON_ENV[@]}" "${IMAGE}")"
cleanup() {
  docker logs "${cid}" || true
  docker rm -f "${cid}" >/dev/null 2>&1 || true
}
trap cleanup EXIT

echo "==> waiting for /api/v1/health"
ok=0
for i in $(seq 1 30); do
  if body="$(curl -fsS "http://127.0.0.1:8000/api/v1/health" 2>/dev/null)"; then
    echo "${body}"
    status_ok=0
    if echo "${body}" | grep -Eq '"status"[[:space:]]*:[[:space:]]*"healthy"'; then
      status_ok=1
    fi
    db_ok=0
    if echo "${body}" | grep -Eq '"database"[[:space:]]*:[[:space:]]*"ok"'; then
      db_ok=1
    fi
    if [[ "${status_ok}" -eq 1 && "${db_ok}" -eq 1 ]]; then
      ok=1
      break
    fi
  fi
  sleep 2
done

if [[ "${ok}" -ne 1 ]]; then
  echo "Health smoke failed" >&2
  exit 1
fi

echo "==> docker smoke OK"

